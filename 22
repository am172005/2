import pandas as pd

def find_s(data):
    attributes = data.columns[:-1]
    target = data.columns[-1]

    hypothesis = None

    for _, row in data.iterrows():

        if row[target] == "Yes":

            if hypothesis is None:
                hypothesis = list(row[attributes])

            else:
                for i in range(len(attributes)):
                    if hypothesis[i] != row[attributes[i]]:
                        hypothesis[i] = "?"

    return hypothesis


def candidate_elimination(data):
    attributes = data.columns[:-1]
    target = data.columns[-1]

    S = ["0"] * len(attributes)
    G = [["?"] * len(attributes)]

    for _, row in data.iterrows():

        x = list(row[attributes])

        if row[target] == "Yes":

            if S == ["0"] * len(attributes):
                S = x.copy()

            else:
                for i in range(len(attributes)):
                    if S[i] != x[i]:
                        S[i] = "?"

            G = [g for g in G
                 if all(g[i] == "?" or g[i] == x[i]
                        for i in range(len(attributes)))]

        else:

            new_G = []

            for g in G:
                for i in range(len(attributes)):
                    if g[i] == "?":
                        h = g.copy()
                        h[i] = S[i]

                        if h not in new_G:
                            new_G.append(h)

            G = new_G

    return S, G


# Main Program

data = pd.read_csv("training_data_new.csv")

print("Training Dataset:\n")
print(data)

find_s_hypothesis = find_s(data)

S, G = candidate_elimination(data)

print("\n========== OUTPUT ==========")

print("\nFind-S Final Hypothesis:")
print(find_s_hypothesis)

print("\nCandidate Elimination")

print("\nMost Specific Hypothesis (S):")
print(S)

print("\nMost General Hypotheses (G):")

for g in G:
    print(g)
